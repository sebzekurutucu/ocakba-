# Backend ortam değişkenleri — bu dosyayı .env olarak kopyalayıp doldur.
# Gerçek .env dosyası ASLA GitHub'a yüklenmez (.gitignore'da).

PORT=3001

# BigQuery
# Servis hesabı JSON dosyasını backend/ klasörüne koy (ör. service-account.json).
# Bu dosya da .gitignore'da — asla GitHub'a yüklenmez.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
BIGQUERY_DATASET=ocakbasi_verisi

# Opsiyonel — verilmezse proje kimliği anahtar dosyasından okunur.
# GCP_PROJECT_ID=
