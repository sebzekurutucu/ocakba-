# Backend ortam değişkenleri — bu dosyayı .env olarak kopyalayıp doldur.
# Gerçek .env dosyası ASLA GitHub'a yüklenmez (.gitignore'da).

PORT=3001

# BigQuery
# Yerel geliştirme: servis hesabı JSON dosyasını backend/ klasörüne koy
# (ör. service-account.json). Bu dosya .gitignore'da — asla GitHub'a yüklenmez.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
BIGQUERY_DATASET=ocakbasi_verisi

# Dağıtım (Vercel/Netlify): dosya yerine JSON'ın tüm içeriğini tek satır olarak
# bu değişkene koy. Tanımlıysa dosya yerine bu kullanılır.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Opsiyonel — verilmezse proje kimliği anahtar dosyasından okunur.
# GCP_PROJECT_ID=
